# ---------------------------------------------------------------------------
# Public site settings (safe to expose in the browser bundle)
# ---------------------------------------------------------------------------

# Canonical production URL, no trailing slash. Used for SEO tags, robots.txt
# and sitemap.xml. Example: https://uno.yourdomain.com
VITE_SITE_URL=

# Shown in the About / Privacy / Contact pages. Use a real, monitored inbox.
VITE_CONTACT_EMAIL=

# Optional: site name used in the UI/legal pages.
VITE_SITE_NAME=UNO Classic

# ---------------------------------------------------------------------------
# Google AdSense
# ---------------------------------------------------------------------------
# Your AdSense publisher ID, e.g. ca-pub-1234567890123456.
# Leave empty to disable ads (handy while developing or awaiting approval).
VITE_ADSENSE_CLIENT=

# Ad unit slot IDs created at https://adsense.google.com > Ads > By ad unit.
VITE_ADSENSE_SLOT_START_TOP=
VITE_ADSENSE_SLOT_START_BOTTOM=
VITE_ADSENSE_SLOT_GAME=

# Set to "true" once you have enabled Google's certified CMP
# (Privacy & messaging) for EEA/UK traffic. The custom consent banner is
# hidden when this is true, and Google handles consent itself.
VITE_GOOGLE_CMP=false

# Set to "false" if you want to use only Google's CMP and no local banner.
VITE_CUSTOM_CONSENT=true

# ---------------------------------------------------------------------------
# Google Analytics 4 (optional; only loads after analytics consent)
# ---------------------------------------------------------------------------
# Measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable analytics.
VITE_GA_ID=
